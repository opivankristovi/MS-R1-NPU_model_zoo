{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose build:*)",
      "Bash(docker compose run --rm smoke:*)",
      "Bash(docker compose up -d demo:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose -f apps/*/compose.yml up -d --build:*)",
      "Bash(docker compose -f apps/*/compose.yml logs:*)",
      "Bash(docker compose -f apps/*/compose.yml ps:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(tools/fetch_runtime.sh)",
      "Bash(tools/fetch_models.sh)",
      "Read(//mnt/data/npu-models/hub/**)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "Bash(docker compose -f apps/*/compose.yml down:*)"
    ]
  }
}
